{
  "name": "limpo-tour",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-dev": "cross-env NODE_ENV=development webpack --config webpack.config.js",
    "build-prod": "cross-env NODE_ENV=production webpack --config webpack.config.js",
    "watch:build": "cross-env NODE_ENV=development webpack --watch --config webpack.config.js",
    "sass": "sass --watch src:src",
    "watch:serv": "webpack serve --open",
    "dev": "concurrently \"npm run watch:build\" \"npm run watch:serv\" \"npm run sass\""
